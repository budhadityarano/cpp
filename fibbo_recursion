#include <iostream>
#include <stdio.h>


int fibo(int n){
    int t0=0, t1=1, s, i;
    
    if (n<=1) return 1;
    
    for (i=0; 1<n; i++)
    {
        s = t0 + t1;
        t0 = t1;
        t1 = s;
    }
    return s;
}

int main()
{
    printf("%d ", fibo(5));

    return 0;
}
